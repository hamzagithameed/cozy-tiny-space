---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist on Cozy Tiny Space. Browse by room or search the guides instead."
  canonicalPath="/404/"
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-16 text-center">
    <p class="font-display text-7xl font-semibold text-accent">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-ink">This page is not here</h1>
    <p class="mx-auto mt-3 max-w-md text-muted">
      The link may be old, or the page may have moved. The guides are all still
      here — pick a room below.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-accent px-6 py-3 font-semibold text-white no-underline hover:bg-accent-dark">Home</a>
      <a href="/search/" class="rounded-full border border-line bg-surface px-6 py-3 font-semibold text-ink no-underline hover:border-accent">Search</a>
      <a href="/kitchen-storage/" class="rounded-full border border-line bg-surface px-6 py-3 font-semibold text-ink no-underline hover:border-accent">Kitchen Storage</a>
    </div>
  </div>
</BaseLayout>
