---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../utils/site';
---

<BaseLayout
  title="Copyright & Takedown"
  description="Cozy Tiny Space image policy: AI-generated illustrations created for this site; we never use a creator's work without a licence or written permission. How creators can request a correction or removal."
  canonicalPath="/copyright/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Copyright & Takedown', url: '/copyright/' },
  ]}
>
  <div class="mx-auto max-w-3xl px-4 pb-4 pt-10">
    <h1 class="font-display text-[clamp(2rem,5vw,3rem)] font-semibold tracking-tight text-ink">
      Copyright &amp; Takedown
    </h1>
    <div class="mt-6 space-y-6 leading-relaxed text-ink-soft">
      <p>
        {SITE.name} is built on a simple rule: <strong>credit is not
        permission.</strong> The illustrations published on this site are
        AI-generated images created for {SITE.name}. If stock photographs or
        a creator's work are ever used, they will be licensed for this use or
        used with the creator's written permission and a visible credit line
        linking back to the original.
      </p>
      <section>
        <h2 class="font-display text-[1.35rem] font-semibold text-ink">Other creators' media</h2>
        <p class="mt-2">
          We do not download, re-upload, embed or alter other creators'
          photographs or videos. Where a guide discusses a product or method,
          the visuals are our own illustrations of that method — never a
          creator's media presented as ours.
        </p>
      </section>
      <section>
        <h2 class="font-display text-[1.35rem] font-semibold text-ink">If you are a creator</h2>
        <p class="mt-2">
          If your work appears on this site and you would like the credit
          changed, a link corrected, or the image or embed removed, email
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with the page URL
          and your post URL. Our policy is <strong>remove first, discuss
          second</strong>: the item comes down while we check, normally
          within two business days, and every request is logged.
        </p>
      </section>
      <section>
        <h2 class="font-display text-[1.35rem] font-semibold text-ink">DMCA notices</h2>
        <p class="mt-2">
          Copyright holders or their agents can send a takedown notice to
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with: your name
          and contact details, the work you own, the exact page URL on this
          site, and a good-faith statement that the use is not authorised.
          Valid notices are acted on promptly, and repeat infringers — if any
          ever appear here — lose access permanently.
        </p>
      </section>
      <section>
        <h2 class="font-display text-[1.35rem] font-semibold text-ink">Our own content</h2>
        <p class="mt-2">
          The text and original images on this site belong to
          {SITE.name}. You may quote short excerpts with a link back; please
          do not republish full articles or our images without
          asking first.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
