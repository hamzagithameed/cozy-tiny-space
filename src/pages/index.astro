---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getPublishedArticles, articleUrl } from '../utils/posts';
import { CATEGORY_LABELS, CATEGORY_ORDER, SITE } from '../utils/site';

const articles = await getPublishedArticles();
const categories = await getCollection('categories');
const categoryBySlug = new Map(categories.map((c) => [c.data.slug, c]));

// Editor's Picks — the complete guide for each room, chosen by the editor.
const picks = CATEGORY_ORDER.map(
  (slug) => articles.find((a) => a.data.category === slug && a.data.pillar)!,
).filter(Boolean);

// Latest — newest guides first, at most two per room so one busy
// category cannot fill the whole row. Nothing repeats across sections.
const shown = new Set<string>(picks.map((a) => a.id));
const latest: typeof articles = [];
const perCategory = new Map<string, number>();
for (const a of articles) {
  if (latest.length >= 6) break;
  if (shown.has(a.id)) continue;
  const n = perCategory.get(a.data.category) ?? 0;
  if (n >= 2) continue;
  perCategory.set(a.data.category, n + 1);
  latest.push(a);
  shown.add(a.id);
}

// One section per room — that room's guides not already shown above.
// No cap below the room's full set: at 30 guides, every article earns
// exactly one homepage link.
const categorySections = CATEGORY_ORDER.map((slug) => {
  const posts = articles
    .filter((a) => a.data.category === slug && !shown.has(a.id))
    .slice(0, 6);
  return { slug, cat: categoryBySlug.get(slug), posts };
}).filter((s) => s.posts.length > 0);

const problemChips = [
  { label: 'No closet?', href: '/bedroom-closet-storage/no-closet-bedroom-storage-create-wardrobe/' },
  { label: "Can't drill?", href: '/renter-guides/no-drill-shelves-apartment-walls-compared/' },
  { label: 'No pantry?', href: '/kitchen-storage/small-apartment-pantry-organization-no-pantry/' },
  { label: 'Tiny bathroom?', href: '/bathroom-storage/renter-friendly-bathroom-storage-ideas-tiny-bathrooms/' },
  { label: 'Shoes everywhere?', href: '/living-room-entryway-storage/small-apartment-shoe-storage-without-drilling/' },
  { label: 'No entryway?', href: '/living-room-entryway-storage/create-drop-zone-small-rental-no-entryway/' },
];

const faqs = [
  {
    q: 'Can you really add storage in a rental without drilling?',
    a: 'Yes. Tension rods, adhesive systems, over-door racks and freestanding furniture can add a surprising amount of storage without a single hole. Every guide on this site states what the solution hangs on, what it holds, and exactly how it comes off again at move-out.',
  },
  {
    q: 'Will adhesive hooks and shelves damage the paint?',
    a: 'On the surfaces the makers rate them for — smooth tile, glass, metal, sealed wood and most sound painted walls — and removed following the maker\u2019s instructions, they are designed to come off cleanly. The honest exceptions are textured walls, wallpaper, fresh paint and steamy bathrooms, and the guides flag those cases and name an alternative.',
  },
  {
    q: 'How much weight can no-drill storage actually hold?',
    a: 'It depends entirely on the product. Small adhesive hooks are rated from under a pound, while the largest strip-based systems are rated into double figures by their makers. Rather than guess, every guide here quotes the manufacturer\u2019s own published rating and says what that means in real items — coats, pans, bottles.',
  },
  {
    q: 'Are the photos on Cozy Tiny Space real homes?',
    a: 'No — and the site says so openly. The images are AI-generated illustrations, created to show each idea; they are never photographs of a real install or a test result, and the policy is set out in full on our How We Research page. The measurements, weight ratings and removal steps in the text come from manufacturer documentation and standard rental rules.',
  },
  {
    q: 'My lease bans adhesives too. Is there anything here for me?',
    a: 'Yes. Tension rods press between walls, over-door racks hang on the door itself, and freestanding shelves and furniture touch nothing at all. The Renter Guides section compares every method by how it attaches, so you can filter for the ones your lease allows.',
  },
  {
    q: 'Where should a new reader start?',
    a: 'With the complete guide for your room in Editor\u2019s Picks below — one per room, each covering the whole space. Then use the Renter Guides for the methods themselves: hooks, rods and shelves compared honestly, with their limits stated.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="More storage in your small rental — without drilling, damage, or risking your deposit"
  description={SITE.description}
  canonicalPath="/"
>
  <!-- 1. Hero + search + problem chips -->
  <section class="mx-auto max-w-6xl px-4 pb-10 pt-10 sm:pt-14">
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-accent">
          Renter-Friendly Small Space Organization
        </p>
        <h1 class="mt-3 font-display text-[clamp(2.4rem,6vw,3.9rem)] font-semibold leading-[1.08] tracking-tight text-ink" style="text-wrap: balance;">
          More storage in your small rental — without drilling, damage, or risking your deposit.
        </h1>
        <p class="mt-4 max-w-xl text-[1.08rem] leading-relaxed text-muted">
          Practical storage and organization ideas for renters in small apartments.
          Every solution is removable, every measurement is real, and nothing here
          puts your deposit at risk.
        </p>
        <form action="/search/" method="get" role="search" class="mt-6 max-w-xl">
          <label for="hero-search" class="sr-only">Search the guides</label>
          <div class="flex overflow-hidden rounded-full border border-line bg-surface focus-within:border-accent">
            <input
              id="hero-search"
              type="search"
              name="q"
              placeholder="Search 30 guides — try “tension rod” or “under-bed”…"
              autocomplete="off"
              class="w-full flex-1 bg-transparent px-5 py-3 text-[1rem] text-ink placeholder:text-muted focus:outline-none"
            />
            <button
              type="submit"
              class="shrink-0 bg-accent px-5 font-semibold text-white transition hover:bg-accent-dark"
            >
              Search
            </button>
          </div>
        </form>
        <div class="mt-5 flex flex-wrap gap-2">
          {problemChips.map((chip) => (
            <a
              href={chip.href}
              class="rounded-full border border-line bg-surface px-4 py-2 text-[0.9rem] font-medium text-ink no-underline transition hover:border-accent hover:text-accent-dark"
            >
              {chip.label}
            </a>
          ))}
        </div>
        <p class="mt-5 text-[0.88rem] text-muted">
          {articles.length} in-depth guides · 5 rooms · 0 holes in the wall
        </p>
      </div>
      <div class="card-img overflow-hidden rounded-2xl border border-line">
        <img
          src="/images/hero-home.webp"
          alt="A cozy small rental living room with a wooden shelving unit, woven storage baskets and a storage ottoman"
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 2. Trust strip -->
  <section class="border-y border-line bg-surface">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-4">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.92rem] font-medium text-ink">
        <li class="flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sage-soft text-[0.7rem] font-bold text-sage">✓</span>
          Research-checked methods
        </li>
        <li class="flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sage-soft text-[0.7rem] font-bold text-sage">✓</span>
          No drilling, no damage
        </li>
        <li class="flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sage-soft text-[0.7rem] font-bold text-sage">✓</span>
          Deposit-safe, with removal steps
        </li>
      </ul>
      <div class="flex items-center gap-3 sm:ml-auto">
        <a href="/authors/hamza-hameed/" class="flex items-center gap-2 no-underline">
          <img
            src="/images/authors/hamza-hameed.webp"
            alt="Photo of Hamza Hameed"
            width="36"
            height="36"
            loading="lazy"
            decoding="async"
            class="h-9 w-9 rounded-full border border-line object-cover"
          />
          <span class="text-[0.9rem] font-medium text-ink-soft">by Hamza Hameed</span>
        </a>
        <a
          href={SITE.pinterest}
          target="_blank"
          rel="noopener"
          class="rounded-full border border-line bg-paper px-4 py-2 text-[0.88rem] font-semibold text-ink no-underline transition hover:border-accent hover:text-accent-dark"
        >
          Follow on Pinterest
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Editor's Picks — one complete guide per room -->
  {picks.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-10">
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-accent">Editor's Picks</p>
      <h2 class="mt-2 font-display text-[clamp(1.6rem,3.4vw,2.1rem)] font-semibold text-ink">Start with the complete guide for your room</h2>
      <p class="mt-1 max-w-2xl text-muted">Five guides, one per room — each covers the whole space end to end. If you read one thing in a room, read its pick.</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )}

  <!-- 4. Latest articles -->
  {latest.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-8">
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-accent">Fresh off the desk</p>
      <h2 class="mt-2 font-display text-[clamp(1.6rem,3.4vw,2.1rem)] font-semibold text-ink">Latest articles</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )}

  <!-- 5. Browse by room -->
  <section id="browse-by-room" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-8">
    <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.1rem)] font-semibold text-ink">Browse by room</h2>
    <p class="mt-1 text-muted">Pick the room, find the fix. Every guide is written for renters.</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORY_ORDER.map((slug) => {
        const cat = categoryBySlug.get(slug);
        const count = articles.filter((a) => a.data.category === slug).length;
        return (
          <a href={`/${slug}/`} class="reveal group block rounded-2xl border border-line bg-surface p-5 no-underline transition hover:border-accent">
            <div class="card-img overflow-hidden rounded-xl">
              <img
                src={`/images/categories/${slug}.webp`}
                alt={`${CATEGORY_LABELS[slug]} in a small rental home`}
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
                class="aspect-[3/4] w-full object-cover"
              />
            </div>
            <h3 class="mt-4 font-display text-[1.25rem] font-semibold text-ink group-hover:text-accent-dark">
              {cat?.data.name ?? CATEGORY_LABELS[slug]}
            </h3>
            <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{cat?.data.tagline}</p>
            <p class="mt-2 text-[0.85rem] font-semibold text-accent-dark">
              {count} {count === 1 ? 'guide' : 'guides'} →
            </p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 6. One section per room -->
  {categorySections.map(({ slug, cat, posts }) => (
    <section class="mx-auto max-w-6xl px-4 py-8">
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-accent">{CATEGORY_LABELS[slug]}</p>
      <h2 class="mt-2 font-display text-[clamp(1.6rem,3.4vw,2.1rem)] font-semibold text-ink">{cat?.data.name ?? CATEGORY_LABELS[slug]}</h2>
      <p class="mt-1 max-w-2xl text-muted">{cat?.data.tagline}</p>
      <div class={`mt-6 grid gap-6 sm:grid-cols-2 ${posts.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
        {posts.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
      <p class="mt-5">
        <a href={`/${slug}/`} class="font-semibold">All {CATEGORY_LABELS[slug].toLowerCase()} guides →</a>
      </p>
    </section>
  ))}

  <!-- 7. How we research -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="rounded-2xl border border-line bg-sage-soft p-6 sm:p-8">
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-sage">How we research</p>
      <h2 class="mt-2 font-display text-[clamp(1.5rem,3vw,2rem)] font-semibold text-ink">
        Every weight limit on this site is checked, not copied.
      </h2>
      <p class="mt-2 max-w-3xl leading-relaxed text-ink-soft">
        Adhesive ratings come from the manufacturer's own published figures, removal
        steps follow the maker's instructions, and measurements are stated in both
        imperial and metric. Where a method fails — on textured walls, in steam,
        over its rated weight — the guide says so, and says what to use instead.
      </p>
      <p class="mt-4">
        <a href="/how-we-test/" class="font-semibold">Read how we research and verify →</a>
      </p>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-accent">Good questions</p>
    <h2 class="mt-2 font-display text-[clamp(1.6rem,3.4vw,2.1rem)] font-semibold text-ink">Renter storage, answered honestly</h2>
    <div class="mx-auto mt-6 max-w-3xl rounded-2xl border border-line bg-surface px-6">
      {faqs.map((f) => (
        <details class="faq-item border-b border-line last:border-b-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
            <span class="font-display text-[1.12rem] font-semibold text-ink">{f.q}</span>
            <span class="faq-arrow shrink-0 text-[0.8rem] text-accent transition-transform duration-200" aria-hidden="true">▼</span>
          </summary>
          <p class="pb-5 leading-relaxed text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
    <style>
      details.faq-item[open ] .faq-arrow { transform: rotate(180deg); }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </section>

  <!-- 9. Newsletter (dark band) -->
  <section class="mt-8 bg-espresso">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 class="font-display text-[clamp(1.7rem,3.4vw,2.3rem)] font-semibold leading-tight text-cream" style="text-wrap: balance;">
          The Deposit-Safe Renter Checklist, free in your inbox
        </h2>
        <p class="mt-3 max-w-md leading-relaxed text-cream/80">
          Join the weekly letter and get the move-in/move-out checklist we wish
          every renter had — what to photograph, what never to drill, and how to
          hand back the keys with your full deposit.
        </p>
        <p class="mt-4 flex items-center gap-2 text-[0.92rem] font-medium text-cream">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-cream/15 text-[0.7rem] font-bold text-accent-light">✓</span>
          One practical fix per week · No spam · Unsubscribe anytime
        </p>
      </div>
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>
