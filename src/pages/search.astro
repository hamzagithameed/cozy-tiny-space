---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search every storage and organization guide on Cozy Tiny Space."
  canonicalPath="/search/"
  noindex
>
  <div class="mx-auto max-w-3xl px-4 pb-4 pt-10">
    <h1 class="font-display text-[clamp(2rem,5vw,3rem)] font-semibold tracking-tight text-ink">Search the guides</h1>
    <p class="mt-2 text-muted">Search all 30 storage and organization guides — by room, problem or method.</p>

    <form role="search" class="mt-6" onsubmit="return false;">
      <label for="search-input" class="sr-only">Search articles</label>
      <input
        id="search-input"
        type="search"
        placeholder="Try “no-drill shelves” or “under-bed storage”…"
        autocomplete="off"
        class="w-full rounded-full border border-line bg-surface px-5 py-3.5 text-[1.05rem] text-ink placeholder:text-muted focus:border-accent focus:outline-none"
      />
    </form>
    <p id="search-status" class="mt-3 text-[0.9rem] text-muted" aria-live="polite">
      Type to search. Results appear as you type.
    </p>
    <ul id="search-results" class="mt-4 space-y-3"></ul>

    <noscript>
      <p class="mt-6 rounded-xl border border-line bg-surface p-5">
        Search needs JavaScript. Without it, browse by room instead:
        <a href="/kitchen-storage/">Kitchen</a> ·
        <a href="/bedroom-closet-storage/">Bedroom &amp; Closet</a> ·
        <a href="/bathroom-storage/">Bathroom</a> ·
        <a href="/living-room-entryway-storage/">Living Room &amp; Entryway</a> ·
        <a href="/renter-friendly-solutions/">Renter-Friendly Solutions</a>
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  // Search strategy: Pagefind (built index, ~10 KB) when available,
  // otherwise the generated JSON index at /search-index.json.
  // The JSON index is also the no-Pagefind fallback documented in the README.
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results') as HTMLUListElement | null;
  const statusEl = document.getElementById('search-status') as HTMLParagraphElement | null;

  type Hit = { url: string; title: string; excerpt: string; category: string };

  function renderHits(hits: Hit[]) {
    if (!resultsEl || !statusEl) return;
    if (hits.length === 0) {
      statusEl.textContent = 'No guides matched. Try a different word — for example “shelves”, “closet” or “shoes”.';
      resultsEl.innerHTML = '';
      return;
    }
    statusEl.textContent = `${hits.length} ${hits.length === 1 ? 'guide' : 'guides'} found.`;
    resultsEl.innerHTML = hits
      .map(
        (h) => `<li class="rounded-xl border border-line bg-surface p-4">
          <a href="${h.url}" class="font-display text-[1.15rem] font-semibold leading-snug text-ink no-underline hover:text-accent-dark">${h.title}</a>
          <p class="mt-1 text-[0.93rem] text-muted">${h.excerpt}</p>
          <p class="mt-1 text-[0.8rem] uppercase tracking-[0.1em] text-accent">${h.category}</p>
        </li>`,
      )
      .join('');
  }

  function jsonSearch(index: Hit[], query: string): Hit[] {
    const q = query.toLowerCase();
    const words = q.split(/\s+/).filter(Boolean);
    return index
      .map((item) => {
        const hay = `${item.title} ${item.excerpt} ${item.category}`.toLowerCase();
        const score = words.reduce((n, w) => n + (hay.includes(w) ? 1 : 0), 0);
        return { item, score };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 10)
      .map((r) => r.item);
  }

  let pagefind: { search: (q: string) => Promise<{ results: { data: () => Promise<{ url: string; excerpt: string; meta?: { title?: string } }> }[] }> } | null = null;
  let jsonIndex: Hit[] | null = null;
  let debounce: number | undefined;

  async function ensureEngines() {
    if (!pagefind) {
      try {
        // @vite-ignore — /pagefind/pagefind.js is generated by Pagefind AFTER
        // the Astro build; it does not exist at bundle time.
        const pagefindUrl = '/pagefind/pagefind.js';
        const mod = await import(/* @vite-ignore */ pagefindUrl);
        await mod.init();
        pagefind = mod;
      } catch {
        pagefind = null;
      }
    }
    if (!pagefind && !jsonIndex) {
      try {
        const res = await fetch('/search-index.json');
        jsonIndex = (await res.json()) as Hit[];
      } catch {
        jsonIndex = [];
      }
    }
  }

  input?.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(async () => {
      const query = input.value.trim();
      if (query.length < 2) {
        if (resultsEl) resultsEl.innerHTML = '';
        if (statusEl) statusEl.textContent = 'Type to search. Results appear as you type.';
        return;
      }
      await ensureEngines();
      if (pagefind) {
        const search = await pagefind.search(query);
        const hits: Hit[] = [];
        for (const result of search.results.slice(0, 10)) {
          const data = await result.data();
          hits.push({
            url: data.url,
            title: data.meta?.title ?? data.url,
            excerpt: data.excerpt,
            category: '',
          });
        }
        renderHits(hits);
      } else if (jsonIndex) {
        renderHits(jsonSearch(jsonIndex, query));
      }
    }, 180);
  });

  // Warm the engine on first focus so the first keystroke is fast.
  input?.addEventListener('focus', () => void ensureEngines(), { once: true });
</script>
