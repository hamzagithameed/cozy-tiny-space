---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import QuickFacts from '../components/QuickFacts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
import { articleUrl, formatDate, readingTime, slugOf } from '../utils/posts';
import { CATEGORY_LABELS, SITE } from '../utils/site';

interface Props {
  article: CollectionEntry<'articles'>;
  author: CollectionEntry<'authors'>;
  bodyText: string;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'articles'>[];
}

const { article, author, bodyText, headings, related } = Astro.props;
const { data } = article;
const url = articleUrl(article);
const minutes = readingTime(bodyText);
const absoluteUrl = `${SITE.url}${url}`;
const pinUrl = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(
  absoluteUrl,
)}&media=${encodeURIComponent(`${SITE.url}${data.image}`)}&description=${encodeURIComponent(data.title)}`;
const shareLinks = [
  { label: 'Pinterest', href: pinUrl },
  {
    label: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(absoluteUrl)}`,
  },
  {
    label: 'X',
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(absoluteUrl)}&text=${encodeURIComponent(data.title)}`,
  },
  {
    label: 'WhatsApp',
    href: `https://wa.me/?text=${encodeURIComponent(`${data.title} — ${absoluteUrl}`)}`,
  },
];
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: CATEGORY_LABELS[data.category], url: `/${data.category}/` },
  { name: data.title, url },
];
const authorSlug = slugOf(author.id);
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={url}
  image={data.image}
  type="article"
  publishedDate={data.pubDate}
  updatedDate={data.updatedDate}
  authorName={author.data.name}
  faq={data.faq}
  breadcrumbs={breadcrumbs}
>
  <!-- Reading progress (Outfit Edits pattern) -->
  <div id="reading-progress" class="fixed inset-x-0 top-0 z-50 h-[3px] origin-left scale-x-0 bg-accent" aria-hidden="true"></div>

  <article class="mx-auto max-w-6xl px-4 pb-4 pt-8">
    <nav class="text-[0.85rem] text-muted" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <a href={`/${data.category}/`}>{CATEGORY_LABELS[data.category]}</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page" class="text-ink-soft">{data.title}</span>
    </nav>

    <!-- Centered editorial header -->
    <header class="mx-auto mt-6 max-w-3xl text-center">
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-accent">
        {CATEGORY_LABELS[data.category]}
      </p>
      <h1 class="mt-3 font-display text-[clamp(2rem,5.5vw,3.4rem)] font-semibold leading-[1.12] tracking-tight text-ink" style="text-wrap: balance;">
        {data.title}
      </h1>
      <p class="mt-4 text-[1.05rem] leading-relaxed text-muted">{data.description}</p>
      <p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[0.88rem] text-muted">
        <span>
          By <a href={`/authors/${authorSlug}/`} class="font-medium">{author.data.name}</a>
        </span>
        <span aria-hidden="true">·</span>
        <span>Published {formatDate(data.pubDate)}</span>
        {data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Updated {formatDate(data.updatedDate)}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <div class="mx-auto mt-6 h-px w-16 bg-accent" aria-hidden="true"></div>
    </header>

    <!-- Featured image: wide framed mat, editorial treatment -->
    <figure class="mx-auto mt-8 max-w-4xl">
      {data.instagramUrl ? (
        <InstagramEmbed url={data.instagramUrl} />
      ) : (
        <div class="rounded-2xl border border-line bg-accent-soft p-3 shadow-sm sm:p-5">
          <img
            src={data.image}
            alt={data.imageAlt}
            width="900"
            height="1200"
            fetchpriority="high"
            decoding="async"
            class="mx-auto max-h-[720px] w-auto max-w-full rounded-lg object-contain"
          />
        </div>
      )}
      <figcaption class="mt-3 flex items-center justify-between gap-3 text-[0.85rem] text-muted">
        {data.instagramUrl ? (
          <a
            href={data.instagramUrl}
            target="_blank"
            rel="noopener"
            class="font-medium text-accent-dark underline decoration-accent/40 underline-offset-2"
          >
            Photo: {data.instagramCredit ?? 'Instagram'} on Instagram
          </a>
        ) : (
          <span>{data.imageAlt}</span>
        )}
        <a
          href={pinUrl}
          target="_blank"
          rel="noopener"
          class="shrink-0 rounded-full border border-line bg-surface px-3 py-1.5 font-semibold text-accent-dark no-underline hover:border-accent"
        >
          Pin it
        </a>
      </figcaption>
    </figure>
    {data.instagramUrl && <script async src="https://www.instagram.com/embed.js"></script>}

    <div class="mt-10 lg:flex lg:items-start lg:gap-12">
      <!-- Reading column -->
      <div class="mx-auto w-full min-w-0 max-w-[720px] lg:mx-0">
        <!-- Editorial note (Outfit Edits pattern): how this guide was put together -->
        <div class="mb-8" aria-label="About this guide">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-accent">About this guide</p>
          <p class="mt-2 text-[0.95rem] font-light leading-relaxed text-ink-soft">
            This guide is researched, not improvised: weight limits come from the
            manufacturers' own published figures, dimensions are given in imperial
            and metric, and every method is checked against standard rental rules —
            what it can do to your walls, and how it comes off at move-out.
            <a href="/how-we-test/" class="font-medium">How we research and verify →</a>
          </p>
        </div>

        <AdSlot id="article-top" />

        <div class="my-8">
          <TableOfContents headings={headings} />
        </div>

        <div class="article-body" data-pagefind-body>
          <slot />
        </div>

        <AdSlot id="article-mid" />

        <section class="mt-10" aria-label="Frequently asked questions">
          <h2 class="font-display text-[clamp(1.5rem,3vw,1.9rem)] font-semibold text-ink">
            Frequently asked questions
          </h2>
          <div class="mt-4 space-y-3">
            {data.faq.map((item) => (
              <details class="faq-item rounded-xl border border-line bg-surface px-5 py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <span class="faq-plus shrink-0 text-[1.1rem] font-normal leading-none text-accent transition-transform duration-200" aria-hidden="true">+</span>
                </summary>
                <p class="mt-2 text-[0.98rem] leading-relaxed text-ink-soft">{item.a}</p>
              </details>
            ))}
          </div>
        </section>

        <!-- Share row (Outfit Edits pattern) -->
        <div class="my-10 flex flex-wrap items-center justify-between gap-4 border-y border-line py-5">
          <span class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-muted">Share this article</span>
          <div class="flex flex-wrap gap-2">
            {shareLinks.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="rounded-full border border-line bg-surface px-4 py-2 text-[0.85rem] font-semibold text-ink no-underline transition hover:border-accent hover:text-accent-dark"
              >
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar: Meet the Author + quick facts + tags + newsletter -->
      <aside class="mx-auto mt-10 w-full max-w-[420px] lg:mt-0 lg:w-[300px] lg:shrink-0">
        <div class="space-y-6 lg:sticky lg:top-24">
          <div class="rounded-2xl border border-line bg-surface p-6 text-center">
            <a href={`/authors/${authorSlug}/`} class="inline-block">
              <img
                src={author.data.avatar}
                alt={`Photo of ${author.data.name}`}
                width="80"
                height="80"
                loading="lazy"
                decoding="async"
                class="mx-auto h-20 w-20 rounded-full border border-line object-cover"
              />
            </a>
            <p class="mt-3 text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-accent">Meet the Author</p>
            <p class="mt-1 font-display text-xl font-semibold text-ink">
              <a href={`/authors/${authorSlug}/`} class="no-underline hover:text-accent-dark">{author.data.name}</a>
            </p>
            <p class="text-[0.85rem] font-medium text-accent-dark">{author.data.role}</p>
            <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-soft">{author.data.bio}</p>
            <p class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1 text-[0.85rem]">
              {author.data.website && (
                <a href={author.data.website} target="_blank" rel="noopener">Outfit Edits</a>
              )}
              {author.data.linkedin && (
                <a href={author.data.linkedin} target="_blank" rel="noopener">LinkedIn</a>
              )}
              {author.data.github && (
                <a href={author.data.github} target="_blank" rel="noopener">GitHub</a>
              )}
              {author.data.email && <a href={`mailto:${author.data.email}`}>Email</a>}
            </p>
          </div>

          <QuickFacts
            bestFor={data.bestFor}
            drilling={data.drilling}
            budget={data.budget}
            timeNeeded={data.timeNeeded}
          />

          <div class="rounded-2xl border border-line bg-surface p-5">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-muted">Tags</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <li class="rounded-full bg-accent-soft px-3 py-1 text-[0.85rem] font-medium text-accent-dark">
                  {tag}
                </li>
              ))}
            </ul>
          </div>

          <NewsletterForm compact />
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mx-auto mt-14 max-w-6xl border-t border-line pt-10" aria-label="Related articles">
        <div class="text-center">
          <h2 class="text-[0.78rem] font-semibold uppercase tracking-[0.2em] text-ink">You Might Also Like</h2>
          <div class="mx-auto mt-3 h-px w-12 bg-accent" aria-hidden="true"></div>
          <p class="mt-3">
            <a href={`/${data.category}/`} class="text-[0.85rem] font-medium uppercase tracking-[0.1em] text-muted no-underline hover:text-accent-dark">
              Explore more in {CATEGORY_LABELS[data.category]} →
            </a>
          </p>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((post) => (
            <ArticleCard article={post} />
          ))}
        </div>
      </section>
    )}
  </article>

  <style>
    details.faq-item[open ] .faq-plus { transform: rotate(45deg); }
    .article-body .pin-frame {
      margin: 1.75rem 0;
      border: 1px solid var(--color-line, #e5ded2);
      border-radius: 0.75rem;
      overflow: hidden;
      background: #fff;
    }
    .article-body .pin-frame img {
      display: block;
      width: 100%;
      margin: 0;
      border-radius: 0;
    }
    .article-body .pin-save {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.65rem 0;
      border-top: 1px solid var(--color-line, #e5ded2);
      color: #e60023;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background 0.25s ease, color 0.25s ease;
    }
    .article-body .pin-save:hover { background: #e60023; color: #fff; }
    .article-body .pin-save:hover svg { fill: #fff; }
  </style>

  <script is:inline>
    // Reading progress bar
    (function () {
      var bar = document.getElementById('reading-progress');
      if (!bar) return;
      function update() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        var p = max > 0 ? h.scrollTop / max : 0;
        bar.style.transform = 'scaleX(' + p + ')';
      }
      document.addEventListener('scroll', update, { passive: true });
      update();
    })();

    // Frame every in-article image with a Save to Pinterest bar (Outfit Edits pattern)
    (function () {
      var pinSvg = '<svg width="13" height="14" viewBox="0 0 24 24" fill="#E60023" aria-hidden="true"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.992 3.993-.283 1.194.599 2.169 1.775 2.169 2.13 0 3.769-2.247 3.769-5.491 0-2.871-2.063-4.878-5.01-4.878-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.179 23.774 10.551 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>';
      document.querySelectorAll('.article-body img').forEach(function (img) {
        if (img.closest('.pin-frame')) return;
        var frame = document.createElement('div');
        frame.className = 'pin-frame';
        var parent = img.parentElement;
        if (parent && parent.tagName === 'P' && parent.childNodes.length === 1) {
          parent.replaceWith(frame);
          frame.appendChild(img);
        } else {
          img.parentNode.insertBefore(frame, img);
          frame.appendChild(img);
        }
        var src = img.getAttribute('src') || '';
        var abs = src.indexOf('http') === 0 ? src : window.location.origin + src;
        var a = document.createElement('a');
        a.href = 'https://pinterest.com/pin/create/button/?url=' + encodeURIComponent(window.location.href) + '&media=' + encodeURIComponent(abs) + '&description=' + encodeURIComponent(img.alt || document.title);
        a.target = '_blank';
        a.rel = 'noopener';
        a.className = 'pin-save';
        a.innerHTML = pinSvg + 'Save to Pinterest';
        frame.appendChild(a);
      });
    })();
  </script>
</BaseLayout>
