---
import { CATEGORY_LABELS, CATEGORY_ORDER, SITE } from '../utils/site';
import NewsletterForm from './NewsletterForm.astro';
---

<footer class="mt-16 bg-espresso text-cream">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl font-semibold text-cream">Cozy Tiny Space</p>
        <p class="mt-2 max-w-sm text-[0.95rem] leading-relaxed text-cream/75">
          More storage, better organization, without permanent changes. Practical
          renter-friendly storage ideas for small apartments — no drilling, no
          damage, no lost deposit.
        </p>
        <div class="mt-5 rounded-2xl bg-surface p-4">
          <NewsletterForm compact />
        </div>
      </div>
      <nav aria-label="Categories">
        <p class="text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-cream/55">Browse by room</p>
        <ul class="mt-3 space-y-2 text-[0.95rem]">
          {CATEGORY_ORDER.map((slug) => (
            <li><a href={`/${slug}/`} class="text-cream/85 no-underline hover:text-accent-light">{CATEGORY_LABELS[slug]}</a></li>
          ))}
          <li><a href="/search/" class="text-cream/85 no-underline hover:text-accent-light">Search</a></li>
        </ul>
      </nav>
      <nav aria-label="Site pages">
        <p class="text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-cream/55">Site</p>
        <ul class="mt-3 space-y-2 text-[0.95rem]">
          <li><a href="/about/" class="text-cream/85 no-underline hover:text-accent-light">About</a></li>
          <li><a href="/how-we-test/" class="text-cream/85 no-underline hover:text-accent-light">How We Test</a></li>
          <li><a href="/contact/" class="text-cream/85 no-underline hover:text-accent-light">Contact</a></li>
          <li><a href="/authors/hamza-hameed/" class="text-cream/85 no-underline hover:text-accent-light">About the author</a></li>
          <li><a href="/privacy-policy/" class="text-cream/85 no-underline hover:text-accent-light">Privacy Policy</a></li>
          <li><a href="/disclaimer/" class="text-cream/85 no-underline hover:text-accent-light">Disclaimer</a></li>
          <li><a href="/affiliate-disclosure/" class="text-cream/85 no-underline hover:text-accent-light">Affiliate Disclosure</a></li>
          <li><a href="/copyright/" class="text-cream/85 no-underline hover:text-accent-light">Copyright &amp; Takedown</a></li>
          <li><a href="/rss.xml" class="text-cream/85 no-underline hover:text-accent-light">RSS Feed</a></li>
        </ul>
      </nav>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-cream/15 pt-5 text-[0.85rem] text-cream/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p>
        No affiliate links yet — see the <a href="/affiliate-disclosure/" class="text-cream/85 hover:text-accent-light">Affiliate Disclosure</a> for our policy.
      </p>
    </div>
  </div>
</footer>
