---
interface Props {
  bestFor: string;
  drilling: string;
  budget: string;
  timeNeeded: string;
}
const { bestFor, drilling, budget, timeNeeded } = Astro.props;
---

<aside class="rounded-2xl border border-line bg-surface p-5" aria-label="Quick facts">
  <p class="text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-muted">Quick facts</p>
  <dl class="mt-3 grid gap-3 text-[0.95rem] sm:grid-cols-2">
    <div>
      <dt class="font-semibold text-ink">Best for</dt>
      <dd class="text-ink-soft">{bestFor}</dd>
    </div>
    <div>
      <dt class="font-semibold text-ink">Drilling required?</dt>
      <dd class="text-ink-soft">{drilling}</dd>
    </div>
    <div>
      <dt class="font-semibold text-ink">Approximate budget</dt>
      <dd class="text-ink-soft">{budget}</dd>
    </div>
    <div>
      <dt class="font-semibold text-ink">Time needed</dt>
      <dd class="text-ink-soft">{timeNeeded}</dd>
    </div>
  </dl>
</aside>
