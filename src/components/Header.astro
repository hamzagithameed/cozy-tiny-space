---
import { CATEGORY_LABELS, CATEGORY_ORDER, SITE } from '../utils/site';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
    <a href="/" class="flex shrink-0 items-baseline gap-2 no-underline" aria-label={`${SITE.name} — home`}>
      <span class="font-display text-[1.55rem] font-semibold leading-none tracking-tight text-ink">
        Cozy Tiny Space
      </span>
      <span class="hidden text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-accent sm:inline">
        Renter-Friendly
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-5 text-[0.92rem] font-medium lg:flex" aria-label="Categories">
      {CATEGORY_ORDER.map((slug) => (
        <a href={`/${slug}/`} class="text-ink-soft no-underline hover:text-accent-dark">
          {CATEGORY_LABELS[slug].replace(' Storage', '').replace(' Solutions', '')}
        </a>
      ))}
      <a href="/shop/" class="font-semibold text-accent-dark no-underline hover:text-accent">Shop</a>
      <a href="/about/" class="text-ink-soft no-underline hover:text-accent-dark">About</a>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <a
        href="/search/"
        class="rounded-full p-2 text-ink-soft no-underline hover:bg-accent-soft hover:text-accent-dark"
        aria-label="Search"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <a
        href={SITE.pinterest}
        target="_blank"
        rel="noopener"
        class="rounded-full p-2 text-ink-soft no-underline hover:bg-accent-soft hover:text-accent-dark"
        aria-label="Pinterest"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.08 2.46 7.58 5.99 9.13-.08-.78-.16-1.97.03-2.82.17-.72 1.1-4.6 1.1-4.6s-.28-.56-.28-1.39c0-1.3.75-2.27 1.69-2.27.8 0 1.18.6 1.18 1.31 0 .8-.51 2-.77 3.11-.22.93.46 1.68 1.38 1.68 1.65 0 2.92-1.74 2.92-4.25 0-2.22-1.6-3.78-3.88-3.78-2.65 0-4.2 1.98-4.2 4.04 0 .8.31 1.66.69 2.13.08.09.09.17.07.27-.07.31-.24.97-.27 1.1-.04.18-.15.22-.34.13-1.25-.58-2.03-2.4-2.03-3.87 0-3.15 2.29-6.04 6.6-6.04 3.46 0 6.16 2.47 6.16 5.77 0 3.42-2.16 6.17-5.15 6.17-1.01 0-1.95-.52-2.28-1.14l-.62 2.36c-.22.86-.83 1.94-1.24 2.6.93.29 1.92.44 2.95.44 5.52 0 10-4.48 10-10S17.52 2 12 2Z" /></svg>
      </a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-full p-2 text-ink-soft hover:bg-accent-soft" aria-label="Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav class="absolute right-0 top-12 w-64 rounded-xl border border-line bg-surface p-3 shadow-lg" aria-label="Mobile menu">
          {CATEGORY_ORDER.map((slug) => (
            <a href={`/${slug}/`} class="block rounded-lg px-3 py-2 text-ink-soft no-underline hover:bg-accent-soft">
              {CATEGORY_LABELS[slug]}
            </a>
          ))}
          <a href="/shop/" class="block rounded-lg px-3 py-2 font-semibold text-accent-dark no-underline hover:bg-accent-soft">Shop</a>
          <a href="/about/" class="block rounded-lg px-3 py-2 text-ink-soft no-underline hover:bg-accent-soft">About</a>
        </nav>
      </details>
    </div>
  </div>
</header>
