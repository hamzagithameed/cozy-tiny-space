---
import { SITE } from '../utils/site';

export interface Breadcrumb {
  name: string;
  url: string;
}
export interface FaqItem {
  q: string;
  a: string;
}
export interface ProductSchema {
  name: string;
  description: string;
  /** USD price, 0 for the free download. */
  price: number;
  /** Canonical purchase URL (the Gumroad listing). */
  url: string;
}

interface Props {
  title: string;
  description: string;
  /** Path, e.g. /kitchen-storage/no-drill-kitchen-storage-for-renters/ */
  canonicalPath?: string;
  /** Path in public/, e.g. /images/kitchen-storage/foo.webp */
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  authorName?: string;
  faq?: FaqItem[];
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  /** Render the title with no brand suffix (articles and shop products). */
  bareTitle?: boolean;
  /** When set, a Product + Offer JSON-LD block is emitted (shop pages). */
  product?: ProductSchema;
}

const {
  title,
  description,
  canonicalPath = '/',

  image = '/images/hero-home.webp',
  type = 'website',
  publishedDate,
  updatedDate,
  authorName = 'Hamza Hameed',
  faq,
  breadcrumbs,
  noindex = false,
  bareTitle = false,
  product,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE.url).toString();
// Social platforms (Pinterest especially) handle JPG more reliably than
// WebP, so og/twitter/schema images use a JPG twin of the page image.
// The displayed page images stay WebP for speed.
const ogImagePath = image.replace(/\.webp$/, '.jpg');
const ogImage = new URL(ogImagePath, SITE.url).toString();
const [ogImageWidth, ogImageHeight] = image.includes('hero-home')
  ? [1920, 1280]
  : image.includes('/authors/')
    ? [400, 400]
    : [1344, 1792];
// Article titles stand alone (no brand suffix) so they stay within the
// ~60 characters Google displays; the suffix remains on hub/static pages.
const pageTitle = canonicalPath === '/' ? `${SITE.name} | ${SITE.tagline}` : type === 'article' || bareTitle ? title : `${title} | ${SITE.name}`;

// JSON-LD: BlogPosting on articles, WebSite on the homepage, plus
// BreadcrumbList and FAQPage where the content supports them.
const jsonLd: Record<string, unknown>[] = [];
if (type === 'article') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: ogImage,
    author: { '@type': 'Person', name: authorName, url: `${SITE.url}/authors/hamza-hameed/` },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
    },
    datePublished: publishedDate?.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  });
} else if (canonicalPath === '/') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', SITE.url).toString(),
      },
    },
  });
}
// The publisher entity, emitted sitewide with a stable @id so every page
// ties back to one Organization.
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.svg', SITE.url).toString(),
  },
  sameAs: [SITE.pinterest],
});
if (product) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.description,
    image: ogImage,
    brand: { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name },
    offers: {
      '@type': 'Offer',
      url: product.url,
      priceCurrency: 'USD',
      price: product.price.toFixed(2),
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
    },
  });
}
if (breadcrumbs && breadcrumbs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.url, SITE.url).toString(),
    })),
  });
}
if (faq && faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="p:domain_verify" content="7b19e1e5a6db824b94ff28905eac49a2" />
<meta name="google-site-verification" content="XCVgXAF55wBb-PJtBm4sW974vRn0pNjxTQKvUdbtVTs" />
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KGTZ1NGTBM"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-KGTZ1NGTBM');
</script>
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={ogImageWidth} />
<meta property="og:image:height" content={ogImageHeight} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={authorName} />}
{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
