---
import type { CollectionEntry } from 'astro:content';
import { articleUrl, formatDate, readingTime } from '../utils/posts';
import { CATEGORY_LABELS } from '../utils/site';

interface Props {
  article: CollectionEntry<'articles'>;
  bodyText?: string;
}
const { article, bodyText = '' } = Astro.props;
const { data } = article;
---

<article class="reveal group">
  <a href={articleUrl(article)} class="block no-underline" aria-label={data.title}>
    <div class="card-img overflow-hidden rounded-xl border border-line bg-surface">
      <img
        src={data.image}
        alt={data.imageAlt}
        width="900"
        height="1200"
        loading="lazy"
        decoding="async"
        class="aspect-[3/4] w-full object-cover"
      />
    </div>
    <p class="mt-3 text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-accent">
      {CATEGORY_LABELS[data.category]}
    </p>
    <h3 class="mt-1 font-display text-[1.3rem] font-semibold leading-snug text-ink group-hover:text-accent-dark">
      {data.title}
    </h3>
    <p class="mt-1 line-clamp-2 text-[0.95rem] leading-relaxed text-muted">{data.description}</p>
    <p class="mt-2 text-[0.82rem] text-muted">
      {formatDate(data.pubDate)}
      {bodyText && ` · ${readingTime(bodyText)} min read`}
    </p>
  </a>
</article>
