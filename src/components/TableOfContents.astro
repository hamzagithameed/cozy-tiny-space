---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 0 && (
  <nav class="rounded-2xl border border-line bg-surface p-5" aria-label="In this article">
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-muted">In this article</p>
    <ol class="mt-3 space-y-2 text-[0.95rem] leading-snug">
      {items.map((h) => (
        <li>
          <a href={`#${h.slug}`} class="text-ink-soft no-underline hover:text-accent-dark">{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
